# REGHEN — Environment Configuration
# Copy this file to .env and set the values for your environment.
# .env is gitignored and must NEVER be committed.

# App environment — controls QA tools and production guards.
# Valid values: development | staging
# Leave unset (or any other value) to enforce production mode (fail-closed).
VITE_APP_ENV=development

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
